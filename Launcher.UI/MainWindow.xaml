<Window x:Class="Launcher.UI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Open Geometry Dash Launcher" Width="1000" Height="670" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize" Background="#0B0D18" Opacity="0" Loaded="Window_Loaded">
 <Window.Resources>
  <SolidColorBrush x:Key="ThemePanelBrush" Color="#141628"/>
  <SolidColorBrush x:Key="ThemeTextBrush" Color="White"/>
  <SolidColorBrush x:Key="ThemeAccentBrush" Color="#7464F5"/>
  <Style TargetType="TextBox"><Setter Property="Margin" Value="5"/><Setter Property="Padding" Value="8"/><Setter Property="Background" Value="{DynamicResource ThemePanelBrush}"/><Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/></Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
   <Setter Property="Background" Value="{DynamicResource ThemePanelBrush}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="6,3"><ContentPresenter/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ThemeAccentBrush}"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Background" Value="{DynamicResource ThemePanelBrush}"/>
   <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid>
     <ToggleButton Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
      <DockPanel><TextBlock Text="⌄" DockPanel.Dock="Right" Width="22" TextAlignment="Center" Foreground="{TemplateBinding Foreground}"/><ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/></DockPanel>
     </ToggleButton>
     <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="{DynamicResource ThemePanelBrush}" BorderBrush="{DynamicResource ThemeAccentBrush}" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="250"><ItemsPresenter/></ScrollViewer></Border></Popup>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid x:Name="Shell"><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border x:Name="HeaderPanel" Grid.Row="0" Grid.ColumnSpan="2" Background="#0C0E1B" MouseLeftButtonDown="Header_Drag" BorderBrush="#282441" BorderThickness="0,0,0,1">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="HeaderTitle" Margin="12,0,0,0" Text="Geometry Dash Launcher" VerticalAlignment="Center" FontSize="11" Foreground="#9091AD"/>
    <Button x:Name="LanguageButton" Grid.Column="1" Width="34" Height="25" Padding="0" Click="Language_Click" Cursor="Hand">
     <Grid Width="24" Height="16">
      <Image x:Name="LanguageFlagImage" Stretch="Uniform" Visibility="Collapsed"/>
      <Canvas x:Name="RussianFlag" Width="24" Height="16" ClipToBounds="True">
       <Rectangle Width="24" Height="16" Fill="White"/>
       <Rectangle Width="24" Height="5.4" Canvas.Top="5.3" Fill="#0039A6"/>
       <Rectangle Width="24" Height="5.4" Canvas.Top="10.6" Fill="#D52B1E"/>
      </Canvas>
      <Canvas x:Name="EnglishFlag" Width="24" Height="16" ClipToBounds="True" Visibility="Collapsed">
       <Rectangle Width="24" Height="16" Fill="#012169"/>
       <Path Data="M0,0 L24,16 M24,0 L0,16" Stroke="White" StrokeThickness="5"/>
       <Path Data="M0,0 L24,16 M24,0 L0,16" Stroke="#C8102E" StrokeThickness="2"/>
       <Rectangle Width="24" Height="6" Canvas.Top="5" Fill="White"/>
       <Rectangle Width="8" Height="16" Canvas.Left="8" Fill="White"/>
       <Rectangle Width="24" Height="3" Canvas.Top="6.5" Fill="#C8102E"/>
       <Rectangle Width="4" Height="16" Canvas.Left="10" Fill="#C8102E"/>
      </Canvas>
     </Grid>
    </Button>
    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="MinimizeButton" Content="—" Click="Minimize_Click" Width="28" Height="25"/><Button x:Name="CloseButton" Content="×" Click="Close_Click" Width="28" Height="25"/></StackPanel>
   </Grid>
  </Border>
  <Border x:Name="Sidebar" Grid.Row="1" Grid.Column="0" Background="#10111F" BorderBrush="#29243D" BorderThickness="0,0,1,0"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="72"/></Grid.RowDefinitions><StackPanel Grid.Row="0" Margin="0,14,0,0"><Button x:Name="HomeNav" Click="Home_Click"/><Button x:Name="GameNav" Click="Game_Click"/><Button x:Name="GeodeNav" Click="Geode_Click"/><Button x:Name="WorkshopNav" Click="Workshop_Click"/><Button x:Name="ThemesNav" Click="Themes_Click"/><Button x:Name="SettingsNav" Click="Settings_Click"/><Button x:Name="AboutNav" Click="About_Click"/></StackPanel><Border x:Name="SteamCard" Grid.Row="1" Background="#191B2E" BorderBrush="#373253" BorderThickness="1" CornerRadius="8" Padding="10" Cursor="Hand" MouseLeftButtonUp="SteamCard_Click"><StackPanel><TextBlock x:Name="SteamIndicator" Text="●  Steam" Foreground="#43D79B" FontWeight="Bold" FontSize="12"/><TextBlock x:Name="SteamNote" Text="Проверка через Steam" FontSize="10" Margin="0,5,0,0"/></StackPanel></Border></Grid></Border>
  <Border x:Name="MainPanel" Grid.Row="1" Grid.Column="1" Margin="28,16,28,12" Background="Transparent"><Grid><Grid.RowDefinitions><RowDefinition Height="80"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions><StackPanel><TextBlock x:Name="Heading" FontSize="28" FontWeight="Bold"/><TextBlock x:Name="Subtitle" Text="Все твои версии — в одном месте." FontSize="13" Margin="0,4,0,0" Foreground="#9191B4"/></StackPanel><ContentControl x:Name="Page" Grid.Row="1"/><TextBlock x:Name="Status" Grid.Row="2" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"/></Grid></Border>
  <Border x:Name="SteamFlyout" Grid.Row="1" Grid.ColumnSpan="2" Panel.ZIndex="10" Width="430" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="205,0,0,14" Background="#191B2E" BorderBrush="#7469F3" BorderThickness="1" CornerRadius="8" Padding="16" Visibility="Collapsed"/>
 </Grid>
</Window>
